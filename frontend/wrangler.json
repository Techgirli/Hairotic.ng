{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hairotic-ng",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "hairotic.com.ng",
      "custom_domain": true
    },
    {
      "pattern": "www.hairotic.com.ng",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hairotic-ng"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.hairotic.com.ng/api/v1",
    "NEXT_PUBLIC_SITE_URL": "https://www.hairotic.com.ng",
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
