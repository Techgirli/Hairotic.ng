{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-hairotic-backend-worker",
  "main": "worker-dist/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "@nestjs/microservices": "./src/worker-optional-modules.ts",
    "@nestjs/microservices/microservices-module": "./src/worker-optional-modules.ts",
    "@nestjs/websockets/socket-module": "./src/worker-optional-modules.ts"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.hairotic.com.ng",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "HAIROTIC_R2",
      "bucket_name": "hairotic-media"
    }
  ],
  "hyperdrive": [
    {
      "binding": "hairotic-ng",
      "id": "f472cf58949a46da8c50b0007294532b"
    }
  ],
  "vars": {
    "APP_URL": "https://www.hairotic.com.ng",
    "CLOUDFLARE_R2_BUCKET_NAME": "hairotic-media",
    "GOOGLE_CLIENT_ID": "62157000572-farfpplfh9thdqg6frg2dtjin4u9ff7v.apps.googleusercontent.com",
    "RESEND_FROM_EMAIL": "notifications@hairotic.com.ng",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4SsTZ_bSrXbtzc7yjC-xeg_ap_FQNZK",
    "NODE_ENV": "production"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
