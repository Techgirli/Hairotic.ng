{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hairotic-backend-worker",
  "main": "dist/main.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "HAIROTIC_R2",
      "bucket_name": "hairotic-media"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
